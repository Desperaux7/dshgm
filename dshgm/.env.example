# Copie para .env (desenvolvimento) e NUNCA envie o .env ao GitHub.
# Em produção, defina estas variáveis no painel do Netlify (Site configuration > Environment variables).

# --- Aplicação ---
# Origem pública do site, sem barra final. Em desenvolvimento use 127.0.0.1 (o Spotify exige esse host).
APP_URL=http://127.0.0.1:5173
# development | production
NODE_ENV=development
# Origens extras permitidas para requisições de escrita (separadas por vírgula). Opcional.
ALLOWED_ORIGINS=
# E-mails que podem entrar (separados por vírgula). OBRIGATÓRIO em produção; em desenvolvimento, vazio libera qualquer conta.
ALLOWED_EMAILS=
# Fuso horário usado na agenda quando o usuário ainda não definiu um.
DEFAULT_TIMEZONE=America/Sao_Paulo
# Porta da API local (npm run dev:api). O Vite encaminha /api para ela.
API_PORT=3001

# --- Banco (Neon) ---
# String de conexão do Neon. Use a conexão "pooled" (host com -pooler) com sslmode=require.
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# --- Segurança ---
# Segredo para assinar cookies temporários do fluxo OAuth (mínimo 32 caracteres).
SESSION_SECRET=
# Chave AES-256 (32 bytes em base64) para criptografar o refresh token do Google Calendar.
TOKEN_ENCRYPTION_KEY=
# Gere os dois valores acima com: npm run gerar-chaves

# --- Google OAuth (Google Cloud Console > APIs e serviços > Credenciais) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URIs de redirecionamento autorizadas a cadastrar no Google Cloud (derivadas de APP_URL):
#   {APP_URL}/api/auth/google/callback
#   {APP_URL}/api/calendario/callback
